# Normalize line endings so Unity YAML files don't show whole-file diffs.
* text=auto

*.cs      text diff=csharp
*.unity   text
*.prefab  text
*.asset   text
*.mat     text
*.meta    text
*.json    text
*.md      text
*.shader  text
*.compute text
*.asmdef  text

# Binary - never touch line endings
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.psd     binary
*.fbx     binary
*.wav     binary
*.mp3     binary
*.ogg     binary
*.ttf     binary
*.dll     binary
